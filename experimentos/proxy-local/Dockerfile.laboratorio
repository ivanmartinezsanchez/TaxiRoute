# Solo para el laboratorio aislado con datos ficticios; no es producción.
FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN python -m pip install --no-cache-dir -r /app/requirements.txt "gunicorn==27.0.0"
COPY taxiroute/ /app/taxiroute/
COPY configuracion/tarifas.json /app/configuracion/tarifas.json
